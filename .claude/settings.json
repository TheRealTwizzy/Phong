{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:suites)",
      "Bash(npm test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e)",
      "Bash(node scripts/e2e-run.mjs *)",
      "Bash(claude plugin list)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "web-games@gamedev-claude-plugins": true,
    "multiplayer@gamedev-claude-plugins": true,
    "juice@gamedev-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "gamedev-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "sponticelli/gamedev-claude-plugins"
      }
    }
  }
}
