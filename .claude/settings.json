{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "web-games@gamedev-claude-plugins": true,
    "multiplayer@gamedev-claude-plugins": true,
    "juice@gamedev-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "gamedev-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "sponticelli/gamedev-claude-plugins"
      }
    }
  }
}
