# PORT: HTTP + WebSocket listen port.
PORT=3000

# DATA_DIR: Directory for the SQLite game database (phong.db). Defaults to
# ./data. In production point this at a persistent volume (/data in Docker),
# otherwise every deploy wipes player profiles, ELO, and match history.
DATA_DIR=./data

# Optional TURN relay for P2P matches behind strict NATs (see DEPLOYMENT.md).
# When unset, clients use public STUN only and fall back to the relay.
# TURN_URL=turn:phong.too-many-coins.com:3478
# TURN_STATIC_SECRET=<openssl rand -hex 32>

# How many reverse proxies sit in front of this server. 1 for the documented
# Traefik/Caddy deployments; 0 when running it directly. Wrong values make
# req.ip either the proxy or a header the client chose.
#TRUST_PROXY_HOPS=1

# How long an empty placeholder profile — a browser that loaded the game and
# never onboarded — is kept before it is swept. Default 7.
#GUEST_PROFILE_TTL_DAYS=7
