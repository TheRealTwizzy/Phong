# PORT: HTTP + WebSocket listen port.
PORT=3000

# DATA_DIR: Directory for the SQLite game database (phong.db). Defaults to
# ./data. In production point this at a persistent volume (/data in Docker),
# otherwise every deploy wipes player profiles, ELO, and match history.
DATA_DIR=./data

# Optional TURN relay for P2P matches behind strict NATs (see DEPLOYMENT.md).
# When unset, clients use public STUN only and fall back to the relay.
# TURN_URL=turn:phong.too-many-coins.com:3478
# TURN_STATIC_SECRET=<openssl rand -hex 32>

# How many reverse proxies sit in front of this server. 1 for the documented
# Traefik/Caddy deployments; 0 when running it directly. Wrong values make
# req.ip either the proxy or a header the client chose.
#TRUST_PROXY_HOPS=1

# How long an empty placeholder profile — a browser that loaded the game and
# never onboarded — is kept before it is swept. Default 7.
#GUEST_PROFILE_TTL_DAYS=7

# ---- Backups -----------------------------------------------------------
# Every account, rating, level, achievement and match is one SQLite file, so
# this is the setting whose absence is unrecoverable.
#
# OFF unless BACKUP_ENABLED is set. That is deliberate: pasting credentials in
# to check them should not also start uploading the player database.
#BACKUP_ENABLED=1
# Where snapshots land. MUST NOT be inside DATA_DIR — scripts/backup.mjs
# refuses that outright, since a backup on the volume it protects is lost with
# it. /backups in the Docker images, which compose mounts as its own volume.
#BACKUP_DIR=/backups
# How many LOCAL snapshots to keep. Offsite retention is a bucket lifecycle
# rule and is NOT this number — see DEPLOYMENT.md.
#BACKUP_KEEP=14
#BACKUP_INTERVAL_HOURS=24

# Offsite. A backup that never leaves the host is not a backup: losing the host
# is the likeliest thing you are recovering from. Leave the endpoint empty and
# only local snapshots are taken.
#
# The credential should be PutObject-ONLY. A key that can delete means an
# attacker who reaches this server can erase the backups, which is exactly the
# scenario offsite backup exists for. There is no DeleteObject or list call in
# this codebase.
#
# Note there is deliberately no fallback to AWS_ACCESS_KEY_ID: ambient
# credentials on a build host must never silently start shipping the database.
#BACKUP_S3_ENDPOINT=https://s3.<region>.<provider>.com
#BACKUP_S3_BUCKET=
#BACKUP_S3_REGION=us-east-1
#BACKUP_S3_PREFIX=phong/
#BACKUP_S3_ACCESS_KEY_ID=
#BACKUP_S3_SECRET_ACCESS_KEY=
# Temporary credentials only (STS). Long-lived keys do not need this.
#BACKUP_S3_SESSION_TOKEN=
# Path style is the default and works everywhere. Set this only if your
# provider requires bucket.endpoint host names.
#BACKUP_S3_VIRTUAL_HOST=1
# Server-side encryption header, e.g. AES256. Opt-in: some providers reject
# headers they do not know.
#BACKUP_S3_SSE=AES256
# Escape hatches. Leave both off in production: the object is the entire player
# database, so over plain HTTP it crosses the network in the clear, and the
# payload hash is what turns a truncated upload into a 400 at the door rather
# than a short object that looks fine until the day you restore it.
#BACKUP_S3_ALLOW_INSECURE=1
#BACKUP_S3_UNSIGNED_PAYLOAD=1
