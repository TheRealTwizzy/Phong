# Copy to the repo root as `.env` (next to docker-compose.yml) and edit.

# The public hostname Caddy should serve (DNS A record must point at this box)
PHONG_DOMAIN=phong.too-many-coins.com

# Optional TURN relay for P2P matches behind strict NATs.
# Leave both empty to run STUN-only (fine for most home networks; matches
# that can't connect directly just stay on the relay automatically).
# Enable coturn with: docker compose --profile turn up -d
# Generate a secret with: openssl rand -hex 32
TURN_STATIC_SECRET=
TURN_URL=turn:phong.too-many-coins.com:3478
