# Copy to the repo root as `.env` (next to docker-compose.yml) and edit.

# The public hostname Caddy should serve (DNS A record must point at this box)
PHONG_DOMAIN=phong.too-many-coins.com

# Optional TURN relay for P2P matches behind strict NATs.
# Leave both empty to run STUN-only (fine for most home networks; matches
# that can't connect directly just stay on the relay automatically).
# Enable coturn with: docker compose --profile turn up -d
# Generate a secret with: openssl rand -hex 32
TURN_STATIC_SECRET=
TURN_URL=turn:phong.too-many-coins.com:3478

# ---- Backups -----------------------------------------------------------
# Read by docker-compose.yml and passed through to the container. Off unless
# BACKUP_ENABLED is set. Full notes in .env.example and DEPLOYMENT.md.
#
# BACKUP_DIR is fixed to /backups in compose (its own volume) — a backup on the
# volume it protects is lost with it.
#BACKUP_ENABLED=1
#BACKUP_KEEP=14
#BACKUP_INTERVAL_HOURS=24

# Offsite. Empty endpoint = local snapshots only, which is half a backup.
# Use a PutObject-only credential: a key that can delete means an attacker who
# reaches this box can erase the backups.
#BACKUP_S3_ENDPOINT=
#BACKUP_S3_BUCKET=
#BACKUP_S3_REGION=us-east-1
#BACKUP_S3_PREFIX=phong/
#BACKUP_S3_ACCESS_KEY_ID=
#BACKUP_S3_SECRET_ACCESS_KEY=

# ---- Play-bots ---------------------------------------------------------
# Simulated players who hold tables, play real matches and climb the same
# ladder. Off unless set. Accounts must already be seeded (they are, at boot).
# Small on purpose: the cost is negligible (see DEPLOYMENT.md), but a room
# should feel alive rather than crowded, and every bot playing is a bot NOT
# sitting at a table a human could join.
#PLAY_BOTS=4
